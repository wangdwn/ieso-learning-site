+/* ====== 诗经拓展阅读 ====== */
+.shijing-promo {
+  padding: 40px 0 8px;
+  background: var(--bg-body);
+}
+.shijing-promo-card {
+  display: flex;
+  align-items: center;
+  gap: 20px;
+  padding: 22px 28px;
+  background: var(--bg-card);
+  border: 1px solid var(--border-color);
+  border-radius: var(--radius);
+  box-shadow: var(--shadow-sm);
+  text-decoration: none;
+  color: inherit;
+  transition: var(--transition);
+}
+.shijing-promo-card:hover {
+  box-shadow: var(--shadow-md);
+  border-color: var(--primary-light);
+  transform: translateY(-2px);
+}
+.shijing-promo-tag {
+  flex-shrink: 0;
+  display: inline-block;
+  padding: 4px 12px;
+  border-radius: 999px;
+  background: rgba(140, 47, 47, 0.1);
+  color: #8c2f2f;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+}
+[data-theme="dark"] .shijing-promo-tag {
+  background: rgba(248, 180, 180, 0.15);
+  color: #f8b4b4;
+}
+.shijing-promo-copy {
+  flex: 1;
+  min-width: 0;
+}
+.shijing-promo-copy h2 {
+  font-size: 20px;
+  font-weight: 800;
+  color: var(--text-primary);
+  margin-bottom: 4px;
+}
+.shijing-promo-copy p {
+  font-size: 14px;
+  color: var(--text-secondary);
+}
+.shijing-promo-go {
+  flex-shrink: 0;
+  font-weight: 700;
+  color: var(--primary);
+}
+@media (max-width: 680px) {
+  .shijing-promo-card {
+    flex-wrap: wrap;
+    padding: 18px 20px;
+  }
+  .shijing-promo-go { width: 100%; }
+}
+
